# Copy to .env.local, or run `npm run setup` to generate it.
SITE_NAME="My Site"
# Links from this host count as "Internal", not referrals.
SITE_URL="https://www.example.com"
# Days are counted in this time zone.
TZ="America/Los_Angeles"
# Event names (data-track="…" or window.track('…')) that count as conversions.
CONVERSION_EVENTS="signup,contact,email,phone,purchase,book"

# Dashboard login. The hash comes from `npm run setup` (scrypt).
ADMIN_USER="admin"
ADMIN_PASSWORD_HASH=""
# Signs the session cookie and salts visitor IDs. 32+ random bytes, e.g. `openssl rand -hex 32`.
APP_SECRET=""

# How many reverse proxies sit in front of the app (1 for Vercel, Render, Fly, nginx…;
# 2 for a CDN in front of a load balancer). Used to find the visitor's real IP in
# X-Forwarded-For. Don't expose `next start` directly: Next.js can't see the real IP then.
TRUSTED_PROXIES="1"
# SQLite file location (default: ./data/analytics.sqlite)
DATA_DIR=""
